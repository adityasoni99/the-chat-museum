{
  "name": "the-chat-museum",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=24.15.0" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm --workspace client run dev -- --host 0.0.0.0",
    "dev:server": "npm --workspace server run dev",
    "build": "npm --workspace client run build && npm --workspace server run build"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
